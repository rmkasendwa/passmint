# Copy to .env.production. Generate independent values with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Hex passwords are URL-safe for the Compose DATABASE_URL.
POSTGRES_PASSWORD=
AUTH_SECRET=

PASSMINT_IMAGE=passmint:local
WEB_PORT=8088
# Keep loopback when using a reverse proxy on the Docker host.
BIND_ADDRESS=127.0.0.1

# Single configuration-owned root administrator. The matching account is
# promoted at startup or registration; changing/removing this revokes old access.
ROOT_ADMIN_EMAIL=
# Optional Google OAuth. With the default same-origin API proxy, set Google's
# authorized redirect URI to:
# https://your-domain.example/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional when the deployed API origin cannot be inferred.
# GOOGLE_REDIRECT_URI=https://your-domain.example/api/auth/google/callback
# Public web origin that receives the app session after Google sign-in.
WEB_ORIGIN=https://your-domain.example
# Optional first deploy on Coolify with an empty database; disable after success.
# INITIALIZE_DATABASE=true

# Default storage: persistent uploads volume, served through the same origin.
PUBLIC_API_URL=/api
LOCAL_UPLOAD_DIR=/app/uploads

# Optional external object storage; omit these to keep volume-backed uploads.
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://your-object-storage-endpoint
# S3_PUBLIC_BASE_URL=https://images.example.com
