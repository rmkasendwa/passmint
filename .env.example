POSTGRES_DB=passmint
POSTGRES_USER=passmint
POSTGRES_PASSWORD=passmint
POSTGRES_PORT=5432
DATABASE_URL=postgres://passmint:passmint@localhost:5432/passmint
API_PORT=3000
WEB_PORT=8088
# Optional. Defaults to http://localhost:${API_PORT} in local scripts and Docker.
# NEXT_PUBLIC_API_URL=http://localhost:3000
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com

# Event image uploads
# Local development works without S3 and serves files from LOCAL_UPLOAD_DIR at /uploads.
PUBLIC_API_URL=http://localhost:3000
LOCAL_UPLOAD_DIR=uploads
IMAGE_UPLOAD_MAX_BYTES=5242880

# Optional S3-compatible storage. Works with AWS S3, Cloudflare R2, and MinIO.
# S3_BUCKET=passmint-event-images
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=replace-me
# S3_SECRET_ACCESS_KEY=replace-me
# S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# S3_FORCE_PATH_STYLE=true
# S3_PUBLIC_BASE_URL=https://cdn.example.com
