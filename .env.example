# Database
POSTGRES_DB=passmint
POSTGRES_USER=passmint
POSTGRES_PASSWORD=passmint
POSTGRES_PORT=5432
DATABASE_URL=postgres://passmint:passmint@localhost:5432/passmint

# Application ports and URLs
API_PORT=3000
WEB_PORT=8088
# Optional. Defaults to http://localhost:${API_PORT} in local scripts and Docker.
# NEXT_PUBLIC_API_URL=http://localhost:3000

# Authentication and admin access
AUTH_SECRET=replace-with-a-long-random-secret
ADMIN_EMAILS=admin@example.com

# Local S3-compatible storage
# Local development uses MinIO, an S3-compatible object store.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=passmint
MINIO_ROOT_PASSWORD=passmint-dev-secret

# Event image uploads
S3_BUCKET=passmint-event-images
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=passmint
S3_SECRET_ACCESS_KEY=passmint-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_BASE_URL=http://localhost:9000/passmint-event-images
IMAGE_UPLOAD_MAX_BYTES=5242880

# Optional filesystem fallback if S3_* settings are removed.
# PUBLIC_API_URL=http://localhost:3000
# LOCAL_UPLOAD_DIR=uploads

# Production S3-compatible storage also works with AWS S3, Cloudflare R2, and MinIO.
# S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
# S3_PUBLIC_BASE_URL=https://cdn.example.com
